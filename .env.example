# ==========================================================================
# Environment variables — Affiliate Course Platform
#
# CONVENTION: this file is append-only across checkpoints. A later checkpoint
# may ADD new vars here (e.g. AES_ENCRYPTION_KEY in Checkpoint 4, payment/
# payout gateway keys in Checkpoints 3/5) but must never rename or remove an
# existing var without updating checkpoint.md's Global Conventions section
# and flagging it in the Progress Log, since other checkpoints may depend on
# the old name.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets.
#
# QUICK REFERENCE — the app refuses to boot (see src/config/env.js) unless
# ALL of these are set to something (and AES_ENCRYPTION_KEY/ADMIN_JWT_SECRET
# also have to pass their own format checks):
#   DATABASE_URL, JWT_SECRET, COOKIE_SECRET, AES_ENCRYPTION_KEY, ADMIN_JWT_SECRET
# Everything else below has a working default or is optional.
# ==========================================================================

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database (Postgres — REQUIRED) -------------------------------------------
# Single connection-string form, used by both the app (pg Pool) and the
# migration tool (node-pg-migrate reads DATABASE_URL by default).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/affiliate_course_platform

# --- Auth (REQUIRED) -----------------------------------------------------------
# Used to sign/verify JWTs (Checkpoint 2). Generate a long random string for
# real deployments — never reuse this placeholder.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Used to sign the httpOnly cookie that carries the JWT (Checkpoint 2).
COOKIE_SECRET=replace_with_a_different_long_random_string

# --- CAPTCHA (Checkpoint 2) --------------------------------------------------
# STUB — no provider chosen yet (standing open item, see checkpoint.md).
# Leave this UNSET for local development: signup/login work fine without it,
# src/middleware/captcha.middleware.js just logs a one-time warning and lets
# every request through. Setting this to ANYTHING currently makes every
# signup/login request fail with 501 (the stub has no real provider call to
# make yet) — don't set it until a provider is actually implemented.
# CAPTCHA_SECRET_KEY=

# --- Frontend URL (Checkpoint 2) --------------------------------------------
# Used to build links inside emails (password reset) and Checkpoint 7's
# affiliate links. Checkpoint 10 made the frontend same-origin with the API
# (served via express.static from this same process/port) — so this should
# just match wherever this server is reachable. Default fixed to :4000 to
# match PORT below in Checkpoint 11 (was a stale :3000 leftover from before
# Checkpoint 10's same-origin decision, silently producing wrong-origin
# affiliate links in local dev).
FRONTEND_URL=http://localhost:4000

# --- Payment gateway (Checkpoint 3) ------------------------------------------
# Selects the implementation in src/services/payment/index.js. Only "mock"
# exists right now — a real gateway (e.g. Razorpay) later means adding a new
# module there and flipping this var, not touching any calling code.
PAYMENT_GATEWAY_MODE=mock

# Mock gateway only: fraction of charges (0.0-1.0) that randomly fail with NO
# explicit override, to simulate a real gateway occasionally declining a
# charge. 0 (default) = always succeeds unless the request explicitly asks
# to simulate a failure (dev/test only — see mockGateway.js; this override
# is ignored entirely when NODE_ENV=production). Leave at 0 for normal local
# development; every other checkpoint's testing wants predictable charges.
MOCK_PAYMENT_FAILURE_RATE=0

# --- Field-level encryption (Checkpoint 4 — REQUIRED) ------------------------
# AES-256-GCM key for KYC's sensitive fields (Aadhaar, PAN, bank account
# number — see src/utils/encryption.js). Must be base64-encoded and decode
# to EXACTLY 32 bytes; the app refuses to boot otherwise. Generate a real one
# for every environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER reuse the placeholder below outside local dev, and never commit a
# real key anywhere (including here — `.env` is gitignored for exactly this).
AES_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key_see_comment_above

# --- Admin auth (Checkpoint 8 — REQUIRED) ------------------------------------
# Deliberately a DIFFERENT secret from JWT_SECRET above (see
# src/utils/adminAuthToken.js) — the app refuses to boot if these match.
# Generate one the same way as JWT_SECRET/COOKIE_SECRET, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=replace_with_a_different_long_random_string_than_jwt_secret

# Admin session length. Shorter than users' JWT_EXPIRES_IN (7d) by default —
# admins can view all financial/KYC data, so a shorter default session felt
# worth the minor inconvenience. Not spec-mandated; change freely.
ADMIN_JWT_EXPIRES_IN=4h

# --- Payout gateway (Checkpoint 5) -------------------------------------------
# Selects the implementation in src/services/payout/index.js. Only "mock"
# exists right now — mirrors PAYMENT_GATEWAY_MODE's pattern exactly.
PAYOUT_GATEWAY_MODE=mock

# Mock gateway only: fraction of payouts (0.0-1.0) that randomly fail with NO
# explicit override — same reasoning as MOCK_PAYMENT_FAILURE_RATE above.
# 0 (default) = always succeeds unless the request explicitly asks to
# simulate a failure (dev/test only — see src/services/payout/mockGateway.js;
# ignored entirely when NODE_ENV=production).
MOCK_PAYOUT_FAILURE_RATE=0

# ==========================================================================
# Vars expected to be ADDED by later checkpoints (documented here in advance
# so nobody accidentally picks a different name). Do not uncomment/use until
# the relevant checkpoint actually implements the feature.
# ==========================================================================
# MAIL_SERVICE_API_KEY=          # Checkpoint 2 flagged this as needed, but it's still
#                                 # unset/unused — src/utils/mailer.js just logs emails
#                                 # to the console for now (see checkpoint.md open items).
#                                 # Uncomment once a real provider is chosen.

# --- Creator Feed API (optional) ----------------------------------------------
# External CreatorFeed service (payouts + manager assignment). Ask the
# CreatorFeed team for the bearer token. Without it, /api/v1/creator-feed/*
# responds 503 and the Creator Feed page shows a friendly notice.
CREATORFEED_API_BASE_URL=https://prod.creatorfeed.in
CREATORFEED_API_TOKEN=
# Inbound checkout webhook (paste the same key into CreatorFeed's dashboard)
CREATORFEED_WEBHOOK_SECRET=
# 'hmac' (hex HMAC-SHA256 of the raw body) or 'token' (plain shared key)
CREATORFEED_WEBHOOK_MODE=hmac
CREATORFEED_WEBHOOK_HEADER=x-webhook-signature
# Maps CreatorFeed product UUIDs to courses.id, e.g. {"400217a3-...":3}
CREATORFEED_PRODUCT_MAP={}
